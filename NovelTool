<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>ノベルメーカー</title>
<link href="https://fonts.googleapis.com/css2?family=M+PLUS+1p&family=Noto+Sans+JP&family=Noto+Serif+JP&display=swap" rel="stylesheet">
<style>
:root{--bg:#f6f5f2;--fg:#222;--pn:#fff;--bd:#d8d5cf;--ac:#3b6fd4;--mu:#888;--ff:'M PLUS 1p',sans-serif;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:#17181b;--fg:#e8e6e1;--pn:#232529;--bd:#3a3d44;--ac:#7aa2ff;--mu:#9a9a9a;color-scheme:dark}}
:root[data-theme=dark]{--bg:#17181b;--fg:#e8e6e1;--pn:#232529;--bd:#3a3d44;--ac:#7aa2ff;--mu:#9a9a9a;color-scheme:dark}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--ff),sans-serif;line-height:1.6}
header{display:flex;flex-wrap:wrap;gap:6px;align-items:center;padding:8px 12px;border-bottom:1px solid var(--bd);background:var(--pn)}
header span{display:contents}
button,select,input,.btn{font:inherit;font-size:14px;color:var(--fg);background:var(--pn);border:1px solid var(--bd);border-radius:6px;padding:4px 10px}
button,.btn{cursor:pointer}
button:hover,.btn:hover{border-color:var(--ac)}
button.on{background:var(--ac);color:#fff;border-color:var(--ac)}
small,.mut{color:var(--mu)}
main{max-width:960px;margin:0 auto;padding:12px}
nav{display:flex;gap:6px;margin-bottom:10px}
.row,.card{background:var(--pn);border:1px solid var(--bd);border-radius:8px;padding:8px;margin-bottom:8px}
.rh{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-bottom:6px}
.tx{min-height:3.2em;padding:6px 8px;border:1px solid var(--bd);border-radius:6px;outline:none;line-height:1.8}
.tx:focus{border-color:var(--ac)}
.tx:empty:before{content:'ここに文章を書く';color:var(--mu)}
#tb{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-bottom:10px}
.sw{width:26px;height:26px;padding:0;border-radius:50%}
.thumbs{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:8px}
figure{margin:0;width:120px;display:flex;flex-direction:column;gap:4px}
figure img{width:120px;height:120px;object-fit:contain;background:rgba(128,128,128,.2);border-radius:6px}
figure input{width:100%;padding:2px 6px}
#stage{position:relative;aspect-ratio:16/9;margin:0 auto;overflow:hidden;background:#333;border-radius:8px;user-select:none;cursor:pointer}
#bgi{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.sl{position:absolute;bottom:0;height:90%;transform:translateX(-50%)}
.sl img{height:100%;display:block}
.sl img.dim{filter:brightness(.55)}
#box{position:absolute;left:3%;right:3%;bottom:4%;min-height:26%;background:rgba(10,10,20,.8);color:#fff;border-radius:10px;padding:1.4em 1.2em .9em;font-size:clamp(13px,2.4vw,22px);line-height:1.8}
#nm{position:absolute;top:-.9em;left:1em;background:#222;padding:0 .9em;border-radius:6px;font-weight:700;color:#fff}
.ctl{display:flex;justify-content:center;gap:12px;align-items:center;margin-top:10px}
</style>
</head>
<body>
<div id="app">
<header>
<b id="ttl">ノベルメーカー</b>
<span class="edonly"><button id="mE">編集</button><button id="mR">閲覧</button></span>
<select id="fs" title="フォント"></select><button id="th" title="ホワイト/ダーク切り替え">🌓 表示</button>
<span class="edonly"><button id="ex1">編集用を書き出し</button><button id="ex2">閲覧用を書き出し</button><button id="im">読み込み</button><input type="file" id="imp" accept=".json,application/json" hidden></span>
<small id="st"></small>
</header>
<main id="ed">
<nav id="tabs"><button data-t="s">脚本</button><button data-t="c">キャラクター</button><button data-t="g">背景</button></nav>
<section id="ps">
<p><input id="pt" placeholder="作品タイトル" style="width:100%"></p>
<div class="rh"><select id="csel"></select><input id="cname" placeholder="章タイトル"><button id="cadd">＋章を追加</button><button id="cmL">章を前へ</button><button id="cmR">章を後ろへ</button><button id="cdel">章を削除</button></div>
<div id="tb"><span class="mut">選択した文字の色：</span>
<button class="sw" data-c="#e53935" style="background:#e53935"></button><button class="sw" data-c="#fb8c00" style="background:#fb8c00"></button><button class="sw" data-c="#fdd835" style="background:#fdd835"></button><button class="sw" data-c="#43a047" style="background:#43a047"></button><button class="sw" data-c="#1e88e5" style="background:#1e88e5"></button><button class="sw" data-c="#8e24aa" style="background:#8e24aa"></button><button class="sw" data-c="#ec407a" style="background:#ec407a"></button><button class="sw" data-c="#ffffff" style="background:#fff"></button><button class="sw" data-c="#000000" style="background:#000"></button>
<input type="color" id="cp" value="#ff0000" style="padding:0;width:34px;height:28px"><button id="cr">色を戻す</button></div>
<div id="lines"></div>
<button id="al">＋行を追加</button>
<p class="mut">発言者を選ぶと「キャラ名「セリフ」」の形で表示されます。「地の文」を選ぶと名前なしの文章になります。背景を選んだ行で背景が切り替わり、その時に立ち絵はいったん全員退場します。「退場」にチェックすると、その行の前に全員が退場します。</p>
</section>
<section id="pc" hidden><div id="chars"></div><button id="ac">＋キャラクターを追加</button></section>
<section id="pg" hidden><div class="thumbs" id="bgs"></div><label class="btn">＋背景画像を追加<input type="file" accept="image/*" multiple hidden id="ba"></label></section>
</main>
<main id="rd" hidden>
<div id="stage"><img id="bgi" alt="" hidden><div class="sl" id="sl0" style="left:17%"></div><div class="sl" id="sl1" style="left:50%"></div><div class="sl" id="sl2" style="left:83%"></div>
<div id="box"><div id="nm" hidden></div><div id="tt"></div></div></div>
<div class="ctl"><select id="rsel" title="章を選ぶ"></select><button id="bk">← 戻る</button><small id="cnt"></small><small>画面をタッチ／クリックで次へ</small></div>
</main>
</div>
<script id="embed" type="application/json"></script>
<script id="main">
const $=(s,e=document)=>e.querySelector(s),$$=(s,e=document)=>[...e.querySelectorAll(s)];
const E=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const uid=()=>Math.random().toString(36).slice(2,9);
const FONTS=['M PLUS 1p','Noto Sans JP','Noto Serif JP'],LAB=['M PLUS 1p','ゴシック','明朝'],FALL=['sans-serif','sans-serif','serif'];
let S={t:'',f:0,d:null,chars:[],bgs:[],ch:[{id:'c0',n:'第1章',lines:[]}],lines:[]},pos=0,cur=0,tm,tab='s',lr=null,le=null,embed=null,ty=null,typing=false,skip=()=>{};
try{embed=JSON.parse($('#embed').textContent)}catch(e){}
const VO=!!embed;
const ch=id=>S.chars.find(c=>c.id==id);
const di=s=>/^data:image\//.test(s)?s:'';
function clean(h){const t=document.createElement('template');t.innerHTML=h;const o=document.createElement('div');
 (function w(n,p){n.childNodes.forEach(c=>{if(c.nodeType==3)p.append(c.textContent);else if(c.nodeName=='BR')p.append(document.createElement('br'));
  else if(c.nodeType==1){const k=c.nodeName=='FONT'?c.getAttribute('color'):(c.style&&c.style.color);
   if(k&&/^[#\w(),.\s%]+$/.test(k)){const s=document.createElement('span');s.style.color=k;p.append(s);w(c,s)}
   else if(c.nodeName=='DIV'||c.nodeName=='P'){p.append(document.createElement('br'));w(c,p)}else w(c,p)}})})(t.content,o);return o.innerHTML}
function norm(o){const r={t:String(o.t||''),f:FONTS[+o.f]?+o.f:0,d:typeof o.d=='boolean'?o.d:null,chars:[],bgs:[],lines:[]};
 (o.chars||[]).forEach(c=>r.chars.push({id:String(c.id),n:String(c.n||''),p:[0,1,2].includes(+c.p)?+c.p:1,col:/^#[0-9a-f]{6}$/i.test(c.col)?c.col:'#ffffff',faces:(c.faces||[]).map(f=>({id:String(f.id),n:String(f.n||''),i:di(String(f.i||''))}))}));
 (o.bgs||[]).forEach(b=>r.bgs.push({id:String(b.id),n:String(b.n||''),i:di(String(b.i||''))}));
 const ml=a=>(a||[]).map(l=>({c:String(l.c||''),f:String(l.f||''),b:String(l.b||''),r:!!l.r,t:clean(String(l.t||''))}));
 r.ch=o.ch&&o.ch.length?o.ch.map(c=>({id:String(c.id||uid()),n:String(c.n||'章'),lines:ml(c.lines)})):[{id:uid(),n:'第1章',lines:ml(o.lines)}];r.lines=r.ch[0].lines;return r}
if(embed)S=norm(embed);else try{const j=localStorage.getItem('novelapp1');if(j)S=norm(JSON.parse(j))}catch(e){}
function use(i){cur=i;S.lines=S.ch[i].lines}
use(0);
const ser=()=>JSON.stringify({...S,lines:undefined});
const st=m=>{$('#st').textContent=m};
function autosave(){if(VO)return;clearTimeout(tm);tm=setTimeout(()=>{try{localStorage.setItem('novelapp1',ser());st('自動保存しました')}catch(e){st('ブラウザ保存に失敗しました（容量超過の可能性）。書き出しをお使いください')}},400)}
function look(){const r=document.documentElement;r.style.setProperty('--ff',`'${FONTS[S.f]}',${FALL[S.f]}`);if(S.d===null)r.removeAttribute('data-theme');else r.dataset.theme=S.d?'dark':'light';$('#fs').value=S.f;document.title=S.t||'ノベルメーカー'}
$('#fs').innerHTML=LAB.map((f,i)=>`<option value="${i}">${f}</option>`).join('');
$('#fs').onchange=e=>{S.f=+e.target.value;look();autosave()};
$('#th').onclick=()=>{const dk=document.documentElement.dataset.theme?document.documentElement.dataset.theme=='dark':matchMedia('(prefers-color-scheme:dark)').matches;S.d=!dk;look();autosave()};
function img(file,max){return new Promise(r=>{const u=URL.createObjectURL(file),i=new Image();i.onload=()=>{const k=Math.min(1,max/Math.max(i.width,i.height)),c=document.createElement('canvas');c.width=Math.round(i.width*k);c.height=Math.round(i.height*k);c.getContext('2d').drawImage(i,0,0,c.width,c.height);URL.revokeObjectURL(u);r(c.toDataURL('image/webp',.85))};i.onerror=()=>r(null);i.src=u})}
const opts=(a,sel,ph)=>(ph!=null?`<option value="">${ph}</option>`:'')+a.map(x=>`<option value="${x.id}"${x.id==sel?' selected':''}>${E(x.n)}</option>`).join('');
const nl=c=>({c:c||'',f:'',b:'',r:false,t:''});
/* ---- script tab ---- */
function rLines(){const box=$('#lines');box.innerHTML='';
 S.lines.forEach((l,i)=>{const c=ch(l.c),d=document.createElement('div');d.className='row';d.dataset.i=i;
  d.innerHTML=`<div class="rh"><b>${i+1}</b><select class="sp">${opts(S.chars,l.c,'地の文')}</select>`+(c?`<select class="fc">${opts(c.faces,l.f)}</select>`:'')+
  `<select class="bg">${opts(S.bgs,l.b,'背景そのまま')}</select><label><input type="checkbox" class="rs"${l.r?' checked':''}> 退場</label><button class="up">↑</button><button class="dn">↓</button><button class="ad">＋</button><button class="rm">×</button></div><div class="tx" contenteditable="true"></div>`;
  $('.tx',d).innerHTML=l.t;box.append(d)});
 if(!S.lines.length)box.innerHTML='<p class="mut">「＋行を追加」から書き始めましょう。</p>'}
$('#lines').addEventListener('input',e=>{const t=e.target.closest('.tx');if(t){S.lines[+t.parentNode.dataset.i].t=clean(t.innerHTML);autosave()}});
$('#lines').addEventListener('keydown',e=>{if(e.key=='Enter'&&e.target.classList.contains('tx')&&!e.isComposing){e.preventDefault();document.execCommand('insertLineBreak')}});
$('#lines').addEventListener('paste',e=>{if(e.target.classList.contains('tx')){e.preventDefault();document.execCommand('insertText',false,e.clipboardData.getData('text/plain'))}});
$('#lines').addEventListener('change',e=>{const r=e.target.closest('.row');if(!r)return;const l=S.lines[+r.dataset.i],k=e.target.classList;
 if(k.contains('sp')){l.c=e.target.value;l.f='';rLines()}else if(k.contains('fc'))l.f=e.target.value;else if(k.contains('bg'))l.b=e.target.value;else if(k.contains('rs'))l.r=e.target.checked;autosave()});
$('#lines').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;const i=+b.closest('.row').dataset.i,L=S.lines,k=b.classList;
 if(k.contains('rm'))L.splice(i,1);else if(k.contains('up')&&i>0)[L[i-1],L[i]]=[L[i],L[i-1]];else if(k.contains('dn')&&i<L.length-1)[L[i+1],L[i]]=[L[i],L[i+1]];else if(k.contains('ad'))L.splice(i+1,0,nl(L[i].c));else return;rLines();autosave()});
$('#al').onclick=()=>{const L=S.lines;L.push(nl(L.length?L[L.length-1].c:''));rLines();autosave();const t=$$('.tx');t[t.length-1].focus()};
$('#pt').oninput=e=>{S.t=e.target.value;look();autosave()};
document.addEventListener('selectionchange',()=>{const s=getSelection();if(!s.rangeCount||s.isCollapsed)return;const n=s.anchorNode,el=n&&(n.nodeType==1?n:n.parentNode).closest('.tx');if(el){lr=s.getRangeAt(0).cloneRange();le=el}});
function paint(c){if(!lr||!le||!le.isConnected)return st('色を変えたい文字を先に選択してください');le.focus();const s=getSelection();s.removeAllRanges();s.addRange(lr);
 document.execCommand('styleWithCSS',false,true);c?document.execCommand('foreColor',false,c):document.execCommand('removeFormat');
 S.lines[+le.parentNode.dataset.i].t=clean(le.innerHTML);autosave()}
$$('.sw').forEach(b=>b.onclick=()=>paint(b.dataset.c));
$('#cp').onchange=e=>paint(e.target.value);$('#cr').onclick=()=>paint(null);
/* ---- chapters ---- */
function rCh(){$('#csel').innerHTML=S.ch.map((c,i)=>`<option value="${i}">${i+1}. ${E(c.n)}</option>`).join('');$('#csel').value=cur;$('#cname').value=S.ch[cur].n}
$('#csel').onchange=e=>{use(+e.target.value);rCh();rLines()};
$('#cname').oninput=e=>{S.ch[cur].n=e.target.value;$('#csel').options[cur].textContent=`${cur+1}. ${e.target.value}`;autosave()};
$('#cadd').onclick=()=>{S.ch.push({id:uid(),n:'第'+(S.ch.length+1)+'章',lines:[]});use(S.ch.length-1);rCh();rLines();autosave()};
function mv(d){const j=cur+d;if(j<0||j>=S.ch.length)return;[S.ch[cur],S.ch[j]]=[S.ch[j],S.ch[cur]];use(j);rCh();autosave()}
$('#cmL').onclick=()=>mv(-1);$('#cmR').onclick=()=>mv(1);
$('#cdel').onclick=()=>{if(S.ch.length<2)return st('章が1つしかないため削除できません');if(!confirm('この章を削除しますか？'))return;S.ch.splice(cur,1);use(Math.max(0,cur-1));rCh();rLines();autosave()};
/* ---- characters ---- */
function rChars(){$('#chars').innerHTML=S.chars.map(c=>`<div class="card" data-c="${c.id}"><div class="rh"><input class="cn" value="${E(c.n)}" placeholder="名前"><input type="color" class="cc" value="${c.col}" title="名前の色"><select class="cpos">${['左','中央','右'].map((x,i)=>`<option value="${i}"${c.p==i?' selected':''}>立ち位置：${x}</option>`).join('')}</select><button class="cd">キャラ削除</button></div><div class="thumbs">${c.faces.map(f=>`<figure data-f="${f.id}"><img src="${f.i}" alt=""><input class="fn" value="${E(f.n)}" placeholder="表情名"><button class="fd">削除</button></figure>`).join('')}</div><label class="btn">＋表情・立ち絵を追加<input type="file" accept="image/*" multiple hidden class="fa"></label></div>`).join('')||'<p class="mut">まずキャラクターを追加してください。</p>'}
$('#ac').onclick=()=>{S.chars.push({id:uid(),n:'キャラ'+(S.chars.length+1),p:1,col:'#ffffff',faces:[]});rChars();autosave()};
const cc=e=>ch(e.target.closest('.card').dataset.c);
$('#chars').addEventListener('input',e=>{const c=cc(e),k=e.target.classList;if(k.contains('cn'))c.n=e.target.value;else if(k.contains('cc'))c.col=e.target.value;else if(k.contains('fn'))c.faces.find(f=>f.id==e.target.closest('figure').dataset.f).n=e.target.value;else return;autosave()});
$('#chars').addEventListener('change',async e=>{const c=cc(e),k=e.target.classList;
 if(k.contains('cpos')){c.p=+e.target.value;autosave()}
 else if(k.contains('fa')){st('画像を処理中…');for(const f of e.target.files){const d=await img(f,1000);if(d)c.faces.push({id:uid(),n:f.name.replace(/\.[^.]+$/,''),i:d})}rChars();autosave();st('')}});
$('#chars').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;const c=cc(e);
 if(b.classList.contains('cd')){if(!confirm('このキャラクターを削除しますか？'))return;S.chars=S.chars.filter(x=>x!=c);S.lines.forEach(l=>{if(l.c==c.id){l.c='';l.f=''}})}
 else if(b.classList.contains('fd')){const id=b.closest('figure').dataset.f;c.faces=c.faces.filter(f=>f.id!=id);S.lines.forEach(l=>{if(l.f==id)l.f=''})}else return;rChars();autosave()});
/* ---- backgrounds ---- */
function rBgs(){$('#bgs').innerHTML=S.bgs.map(b=>`<figure data-b="${b.id}" style="width:180px"><img src="${b.i}" alt="" style="width:180px;height:101px;object-fit:cover"><input class="bn" value="${E(b.n)}"><button class="bd">削除</button></figure>`).join('')||'<p class="mut">背景画像を追加してください。</p>'}
$('#ba').onchange=async e=>{st('画像を処理中…');for(const f of e.target.files){const d=await img(f,1280);if(d)S.bgs.push({id:uid(),n:f.name.replace(/\.[^.]+$/,''),i:d})}e.target.value='';rBgs();autosave();st('')};
$('#bgs').addEventListener('input',e=>{if(e.target.classList.contains('bn')){S.bgs.find(b=>b.id==e.target.closest('figure').dataset.b).n=e.target.value;autosave()}});
$('#bgs').addEventListener('click',e=>{const b=e.target.closest('.bd');if(!b)return;const id=b.closest('figure').dataset.b;S.bgs=S.bgs.filter(x=>x.id!=id);S.lines.forEach(l=>{if(l.b==id)l.b=''});rBgs();autosave()});
/* ---- tabs / modes ---- */
function showTab(t){tab=t;$$('#tabs button').forEach(b=>b.classList.toggle('on',b.dataset.t==t));$('#ps').hidden=t!='s';$('#pc').hidden=t!='c';$('#pg').hidden=t!='g';
 if(t=='s'){$('#pt').value=S.t;rCh();rLines()}else if(t=='c')rChars();else rBgs()}
$$('#tabs button').forEach(b=>b.onclick=()=>showTab(b.dataset.t));
function mode(m){$('#ed').hidden=m!='e';$('#rd').hidden=m!='r';$('#mE')?.classList.toggle('on',m=='e');$('#mR')?.classList.toggle('on',m=='r');if(m=='r'){$('#rsel').innerHTML=S.ch.map((c,i)=>`<option value="${i}">${i+1}. ${E(c.n)}</option>`).join('');$('#rsel').value=cur;pos=0;draw()}else{clearInterval(ty);showTab(tab)}}
$('#mE').onclick=()=>mode('e');$('#mR').onclick=()=>mode('r');
/* ---- reader ---- */
function stateAt(i){let bg=null,s=[null,null,null];for(let k=0;k<=i&&k<S.lines.length;k++){const l=S.lines[k];if(l.b){bg=l.b;s=[null,null,null]}if(l.r)s=[null,null,null];const c=ch(l.c);if(c)s[c.p]={c,f:l.f}}return{bg,s}}
function draw(){const n=S.lines.length,end=pos>=n,l=S.lines[Math.min(pos,n-1)];$('#cnt').textContent=n?`${Math.min(pos+1,n)} / ${n}`:'';
 if(!n){$('#nm').hidden=true;$$('.sl').forEach(x=>x.innerHTML='');$('#bgi').hidden=true;type(E('この章にはまだ文章がありません。'));return}
 const {bg,s}=stateAt(Math.min(pos,n-1)),b=S.bgs.find(x=>x.id==bg),bi=$('#bgi');
 if(b){bi.src=b.i;bi.hidden=false}else{bi.removeAttribute('src');bi.hidden=true}
 s.forEach((x,k)=>{const el=$('#sl'+k);el.innerHTML='';if(x){const f=x.c.faces.find(q=>q.id==x.f)||x.c.faces[0];if(f){const im=document.createElement('img');im.src=f.i;im.alt=x.c.n;if(l.c&&!end&&l.c!=x.c.id)im.className='dim';el.append(im)}}});
 const c=ch(l.c);if(end){$('#nm').hidden=true;type(E('― '+S.ch[cur].n+' おわり ―（タッチで'+(cur<S.ch.length-1?'次の章へ':'最初から')+'）'));return}
 $('#nm').hidden=!c;if(c){$('#nm').textContent=c.n;$('#nm').style.color=c.col}type(l.t)}
function type(html){clearInterval(ty);const t=$('#tt');t.innerHTML=html;const sp=[],ns=[],w=document.createTreeWalker(t,NodeFilter.SHOW_TEXT);while(w.nextNode())ns.push(w.currentNode);
 ns.forEach(n=>{const f=document.createDocumentFragment();for(const k of n.textContent){const s=document.createElement('span');s.textContent=k;s.style.visibility='hidden';f.append(s);sp.push(s)}n.replaceWith(f)});
 let i=0;typing=sp.length>0;skip=()=>{clearInterval(ty);sp.forEach(s=>s.style.visibility='');typing=false};
 ty=setInterval(()=>{if(i<sp.length)sp[i++].style.visibility='';if(i>=sp.length){clearInterval(ty);typing=false}},35)}
$('#stage').onclick=()=>{if(typing){skip();return}const n=S.lines.length;if(pos<n)pos++;else{use(cur<S.ch.length-1?cur+1:0);$('#rsel').value=cur;pos=0}draw()};
$('#rsel').onchange=e=>{use(+e.target.value);pos=0;draw()};
$('#bk').onclick=()=>{pos=Math.max(0,pos-1);draw()};
document.addEventListener('keydown',e=>{if($('#rd').hidden||/INPUT|SELECT|TEXTAREA/.test(e.target.tagName))return;if(e.key=='ArrowRight'||e.key==' '||e.key=='Enter'){e.preventDefault();$('#stage').click()}else if(e.key=='ArrowLeft')$('#bk').click()});
/* ---- files ---- */
async function saveFile(name,data,type){try{const d=window.claude&&await claude.use('downloads');if(d){await d.save({filename:name,data});return}}catch(e){if(e&&e.code=='declined')return}
 const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([data],{type}));a.download=name;a.click()}
$('#ex1').onclick=()=>saveFile((S.t||'novel')+'_編集用.json',ser(),'application/json');
$('#ex2').onclick=()=>{const c=document.documentElement.cloneNode(true);$$('script',c).forEach(s=>{if(s.id!='embed'&&s.id!='main')s.remove()});
 $('#embed',c).textContent=ser().replace(/</g,'\\u003c');
 ['#lines','#chars','#bgs','#fs','#csel','#rsel','.sl','#tt','#nm','#st'].forEach(q=>$$(q,c).forEach(x=>x.innerHTML=''));$('#bgi',c).removeAttribute('src');
 $$('body>*',c).forEach(x=>{if(x.id!='app'&&x.tagName!='SCRIPT')x.remove()});$('title',c).textContent=S.t||'ノベル';
 saveFile((S.t||'novel')+'_閲覧用.html','<!DOCTYPE html>\n'+c.outerHTML,'text/html')};
$('#im').onclick=()=>$('#imp').click();
$('#imp').onchange=async e=>{const f=e.target.files[0];e.target.value='';if(!f)return;try{const o=norm(JSON.parse(await f.text()));if(!confirm('現在の内容を、読み込んだ内容で置き換えますか？'))return;S=o;use(0);look();autosave();showTab('s');st('読み込みました')}catch(x){st('読み込みに失敗しました（編集用ファイルを選んでください）')}};
/* ---- init ---- */
if(VO){$$('.edonly').forEach(x=>x.remove());$('#ttl').textContent=S.t||'ノベル';look();mode('r')}else{look();mode('e')}
</script>
